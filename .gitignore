# This workspace also contains GIS data and product documents.
# Only the simulation engine, solver, demos and selected examples are published.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/swmm524_engine/
!/swmm-2d-flood/
!/demo_2dflood/
!/testSWMMsample/

/swmm524_engine/*
!/swmm524_engine/CMakeLists.txt
!/swmm524_engine/Readme.txt
!/swmm524_engine/Roadmap.txt
!/swmm524_engine/src/

/swmm-2d-flood/*
!/swmm-2d-flood/src/
!/swmm-2d-flood/tests/
!/swmm-2d-flood/main.py
!/swmm-2d-flood/build_prototype.py
!/swmm-2d-flood/demo_physics.py
!/swmm-2d-flood/requirements.txt

/demo_2dflood/*
!/demo_2dflood/run_demo.py
!/demo_2dflood/generate_data_json.py
!/demo_2dflood/build_standalone.py
!/demo_2dflood/visualize.py
!/demo_2dflood/demo_valley.inp

/testSWMMsample/*
!/testSWMMsample/basic_city_dem_chicago.inp
!/testSWMMsample/ext_inflow_smoke.inp
!/testSWMMsample/generate_large_city_benchmark.py
!/testSWMMsample/run_large_city_benchmark.ps1

# Build products and native libraries
build/
build_*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o
*.pdb
*.ilk
*.exp

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Simulation output (the selected INP inputs above remain tracked)
*.rpt
*.out
*.log
*.tmp
*.bak

# Local configuration, credentials and editor metadata
.env
.env.*
*.pem
*.key
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
