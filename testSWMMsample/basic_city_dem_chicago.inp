[TITLE]
Basic urban drainage demo with DEM-derived surface routing and Chicago hyetograph
; Synthetic SWMM test case with building / green / water / road land uses
; DEM logic is represented by subcatchment slope, polygon layout, node elevation, and outlet assignment
; Parent area CENTRAL_BLOCK is split into S_CENTRAL_A and S_CENTRAL_B to emulate one region draining to two inlets

[OPTIONS]
FLOW_UNITS CMS
INFILTRATION HORTON
FLOW_ROUTING DYNWAVE
LINK_OFFSETS DEPTH
ALLOW_PONDING YES
SKIP_STEADY_STATE NO
START_DATE 04/28/2026
START_TIME 00:00:00
REPORT_START_DATE 04/28/2026
REPORT_START_TIME 00:00:00
END_DATE 04/28/2026
END_TIME 06:00:00
REPORT_STEP 00:05:00
WET_STEP 00:01:00
DRY_STEP 00:05:00
ROUTING_STEP 00:00:30
INERTIAL_DAMPING PARTIAL
NORMAL_FLOW_LIMITED BOTH
FORCE_MAIN_EQUATION H-W
VARIABLE_STEP 0.75
LENGTHENING_STEP 0
MIN_SURFAREA 1.0
MAX_TRIALS 8
HEAD_TOLERANCE 0.0015
SYS_FLOW_TOL 5
LAT_FLOW_TOL 5
MINIMUM_STEP 0.5
THREADS 1

[RAINGAGES]
;;Name Format Interval SCF Source
RG_CHI INTENSITY 0:05 1.0 TIMESERIES TS_CHI

